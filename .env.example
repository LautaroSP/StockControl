# Copiar a .env (no se commitea) o usar User Secrets.
# Con docker compose, la API usa Host=postgres (lo pisa el compose). Esta línea es para dotnet run en la máquina.
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=stockcontrol;Username=stockcontrol;Password=stockcontrol
Jwt__Clave=cambiar-esta-clave-local-de-al-menos-32-chars
IMPORT_CLAVE_DUENO=cambiar-import
SEED_CLAVE=cambiar-seed
MercadoPago__ClientId=
MercadoPago__ClientSecret=
MercadoPago__RedirectUri=http://127.0.0.1:5263/mercadopago/vuelta
MercadoPago__WebhookSecret=
# Captcha del registro (Cloudflare Turnstile, gratis). En local, si quedan vacías, se usa el widget de prueba.
# Turnstile__SiteKey=
# Turnstile__Secret=
# Solo con docker compose --profile produccion. Copiá deploy/Caddyfile.example a Caddyfile.
# SITIO=localhost
# CADDY_EMAIL=
